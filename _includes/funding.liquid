<ul class="funding-logos" aria-label="Funding organizations">
  {% for funder in include.funders %}
    <li class="funding-logos__item">
      <a
        class="funding-logo"
        href="{{ funder.url }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{ funder.name }} (opens in a new tab)"
      >
        <img
          class="funding-logo__image"
          src="{{ funder.logo | relative_url }}"
          alt="{{ funder.name }} logo"
          loading="lazy"
        >
      </a>
    </li>
  {% endfor %}
</ul>
