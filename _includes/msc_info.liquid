{% assign msc = page.msc %}
{% capture access_mail %}mailto:{{ msc.contact }}?subject={{ 'Access request: MSc project list' | uri_escape }}{% endcapture %}
<div class="msc">
  <p class="msc-lead">{{ msc.intro }}</p>

  <div class="msc-cta">
    <div class="msc-cta-icon"><i class="fa-solid fa-list-check"></i></div>
    <div class="msc-cta-body">
      <h3 class="msc-cta-title">Current MSc thesis projects</h3>
      <a class="btn msc-cta-btn" href="{{ msc.list_url }}" target="_blank" rel="noopener">
        Browse MSc projects <i class="fa-solid fa-arrow-up-right-from-square"></i>
      </a>
      <ul class="msc-access">
        <li><i class="fa-solid fa-building-columns"></i> <strong>TU/e students:</strong> open the list with your TU/e account.</li>
        <li>
          <i class="fa-solid fa-envelope"></i> <strong>Not at TU/e?</strong> <a href="{{ access_mail }}">Request access</a> and we'll share it with
          you.
        </li>
      </ul>
    </div>
  </div>
</div>
